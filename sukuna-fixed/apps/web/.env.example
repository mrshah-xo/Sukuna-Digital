
MONGODB_URI=
# ── NEXTAUTH ─────────────────────────────────────────────────
# Generate a secret: run this in terminal: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ── SPARROW SMS (Nepal OTP) ───────────────────────────────────
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# ── CLOUDINARY (File uploads) ────────────────────────────────
# Get from: cloudinary.com → Free account → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── FIREBASE (Push notifications) ────────────────────────────
# Get from: console.firebase.google.com → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── GOOGLE OAUTH (Social login) ───────────────────────────────
# Get from: console.cloud.google.com → APIs → OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── STRIPE (School subscription payments) ────────────────────
# Get from: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── ANTHROPIC (AI features) ───────────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
