+          <InfoRow label="Started" value={startedAt ? formatClockTime(startedAt) : '—'} />
+          <InfoRow label="Resolved" value={resolvedAt ? formatClockTime(resolvedAt) : '—'} />
+          <InfoRow label="Duration" value={startedAt && resolvedAt ? formatDuration(startedAt, resolvedAt) : '—'} />
